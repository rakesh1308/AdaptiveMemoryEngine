# AdaptiveMemoryEngine Configuration
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env   (Linux/Mac)
#   copy .env.example .env (Windows)
#
# .env is in .gitignore and will NOT be committed.

# ===========================
# Provider: choose ONE
# ===========================

# --- Option A: OpenAI (recommended) ---
PROVIDER_TYPE=openai
OPENAI_API_KEY=sk-proj-REPLACE_WITH_YOUR_REAL_KEY
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Option B: Ollama (100% local, free) ---
# PROVIDER_TYPE=ollama
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_CHAT_MODEL=llama3.2

# --- Option C: Google Gemini (free tier) ---
# PROVIDER_TYPE=gemini
# GEMINI_API_KEY=your-key-here

# ===========================
# Server Settings
# ===========================

DATA_DIR=./data
TRANSPORT=stdio
PORT=3000

# ===========================
# Optional: Mixed providers
# (use Anthropic for chat while OpenAI does embeddings)
# ===========================
# INTELLIGENCE_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_YOUR_REAL_KEY
