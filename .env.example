# AdaptiveMemoryEngine (Python)

PROVIDER_TYPE=openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Optional: separate provider for AI features (ask, summarize, auto-tag)
# INTELLIGENCE_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Ollama (local / private)
# PROVIDER_TYPE=ollama
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_CHAT_MODEL=llama3.2

# Gemini
# PROVIDER_TYPE=gemini
# GEMINI_API_KEY=your-key

# Data directory (auto: /data on PaaS, ./data locally)
# DATA_DIR=/data

# Transport: auto-detected from PORT. Set explicitly to force.
# TRANSPORT=stdio|http
# PORT=3000