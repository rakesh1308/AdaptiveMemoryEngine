# AdaptiveMemoryEngine — OpenAI configuration

# Required: your OpenAI API key
OPENAI_API_KEY=sk-your-key-here

# Optional overrides
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Storage
# DATA_DIR=./data            # local default
# DATA_DIR=/data             # PaaS / Docker with a mounted volume
# STORAGE_BACKEND=postgres   # v3 production backend
# DATABASE_URL=postgresql://user:password@postgres.zeabur.internal:5432/postgres
# DATABASE_POOL_MIN=1
# DATABASE_POOL_MAX=10

# Server transport
# stdio (default for local MCP clients like Claude Desktop)
# http  (auto when PORT is set, e.g. on Fly.io / Heroku)
# TRANSPORT=stdio
# PORT=3000

# Optional production HTTP hardening
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# AUTH_TOKEN=replace-with-a-random-token
# ALLOWED_ORIGINS=https://your-typingmind-or-client-origin.example
# ALLOWED_HOSTS=memory.example.com

# Chat exports may only be read from this directory (default: DATA_DIR/imports)
# IMPORT_ROOT=/data/imports
