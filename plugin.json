      "openaiSpec": {
        "name": "import_chat_export",
        "description": "Import an entire AI chat history export file. Supports ChatGPT (conversations.json) and Claude (conversations.json) formats. Platform auto-detected. Optional tag_prefix applied to every imported memory (default 'imported').",
        "parameters": {
          "type": "object",
          "required": ["file_path"],
          "properties": {
            "file_path": {"type": "string", "description": "Absolute path to the export file"},
            "platform": {"type": "string", "enum": ["auto", "chatgpt", "claude"], "description": "Source platform (default: auto-detect)"},
            "tag_prefix": {"type": "string", "description": "Tag prefix applied to every imported memory (default 'imported')"}
          }
        }
      },
      "outputType": "respond_to_ai"
    },
    {
