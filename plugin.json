        "parameters": {
          "type": "object",
          "properties": {
            "format": {"type": "string", "enum": ["json", "csv", "text"], "description": "Output format"},
            "include_versions": {"type": "boolean", "description": "Include version history in JSON output"}
          }
        }
      },
      "outputType": "respond_to_ai"
    },
    {
      "id": "aaaa1120-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
      "name": "import_memories",
